<?xml version="1.0" encoding="utf-8"?>
<!--
  Simple vector launcher icon: concentric "radar" rings over a tinted square.
  Used for both @drawable/ic_launcher and the round icon (manifest).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#1B6C5C"
        android:pathData="M0,0 h108 v108 h-108 z" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:pathData="M54,54 m-30,0 a30,30 0 1,1 60,0 a30,30 0 1,1 -60,0" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:pathData="M54,54 m-14,0 a14,14 0 1,1 28,0 a14,14 0 1,1 -28,0" />

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,46 a8,8 0 1,0 0.001,0 z" />
</vector>
